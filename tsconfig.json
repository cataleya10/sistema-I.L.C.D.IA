{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "paths": {
      "@angular/*": ["frontend-angular/web/node_modules/@angular/*"],
      "rxjs": ["frontend-angular/web/node_modules/rxjs"],
      "rxjs/*": ["frontend-angular/web/node_modules/rxjs/*"],
      "tslib": ["frontend-angular/web/node_modules/tslib"]
    }
  },
  "include": ["src/**/*.ts"]
}
