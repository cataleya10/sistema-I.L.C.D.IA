{
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Default": "Host=CHANGE_ME_DB_HOST;Port=5432;Database=ilcdia;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD"
  },
  "PythonAi": {
    "BaseUrl": "http://CHANGE_ME_AI_HOST:8000",
    "ApiKey": "CHANGE_ME_SHARED_API_KEY",
    "TimeoutSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "CHANGE_ME_FRONTEND_ORIGIN"
    ]
  },
  "Jwt": {
    "SigningKey": "CHANGE_ME_RANDOM_32_PLUS_CHARS_SIGNING_KEY",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationMinutes": 10080,
    "Users": [
      {
        "Username": "CHANGE_ME_ADMIN_USERNAME",
        "PasswordHash": "CHANGE_ME_ADMIN_BCRYPT_HASH",
        "Role": "Admin"
      },
      {
        "Username": "CHANGE_ME_USER_USERNAME",
        "PasswordHash": "CHANGE_ME_USER_BCRYPT_HASH",
        "Role": "User"
      }
    ]
  },
  "Logging": {
    "FilePath": "logs/api.log",
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Processing": {
    "MaxAttempts": 3,
    "RetryDelaySeconds": 5,
    "MaxConcurrentWorkers": 4
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AdminPermitLimit": 300,
    "UserPermitLimit": 120,
    "AnonymousPermitLimit": 30,
    "QueueLimit": 50
  }
}
