{
    "Database": {
        "Provider": "Postgres"
    },
    "ConnectionStrings": {
        "Default": "Host=${DB_HOST};Port=${DB_PORT};Database=ilcdia;Username=${DB_USER};Password=${DB_PASSWORD}"
    },
    "PythonAi": {
        "BaseUrl": "${AI_ENGINE_URL}",
        "ApiKey": "${AI_API_KEY}",
        "TimeoutSeconds": 300
    },
    "Cors": {
        "AllowedOrigins": [
            "${FRONTEND_ORIGIN}"
        ]
    },
    "Jwt": {
        "SigningKey": "${JWT_SIGNING_KEY}",
        "ExpirationMinutes": 120,
        "RefreshTokenExpirationMinutes": 10080
    },
    "Logging": {
        "FilePath": "logs/api.log",
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Processing": {
        "MaxAttempts": 3,
        "RetryDelaySeconds": 5,
        "MaxConcurrentWorkers": 4
    },
    "RateLimiting": {
        "WindowSeconds": 60,
        "AdminPermitLimit": 300,
        "UserPermitLimit": 120,
        "AnonymousPermitLimit": 30,
        "QueueLimit": 50
    }
}
