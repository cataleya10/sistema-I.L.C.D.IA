  },
  "Database": {
    "Provider": "InMemory"
  },
  "Storage": {
    "RootPath": "storage",
    "RetentionDays": 365,
    "CleanupIntervalMinutes": 43200
  },
  "PythonAi": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "",
    "TimeoutSeconds": 300
  },
  "AiEngine": {
    "Provider": "Python"
  },
  "RefreshTokens": {
    "StoragePath": "storage/refresh_tokens.json",
    "CleanupIntervalMinutes": 10080
  },
  "DataProtection": {
    "KeysPath": "storage/data-protection-keys"
  },
  "Upload": {
    "MaxFileSizeBytes": 15728640,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg"
    ]
  },
  "Jwt": {
    "Issuer": "ilcdia",
    "Audience": "ilcdia-web",
    "SigningKey": "CHANGE_ME_USE_ENV",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationMinutes": 10080,
    "Users": [
      {
        "Username": "admin",
        "PasswordHash": "",
        "Role": "Admin"
      },
      {
        "Username": "analyst",
        "PasswordHash": "",
        "Role": "User"
      },
      {
        "Username": "ALEJANDROCALDERON",
        "PasswordHash": "",
        "Role": "Admin"
      }
    ]
  },
  "Google": {
    "ClientId": "CHANGE_ME_USE_ENV",
    "AdminEmails": []
  },
  "SystemInfo": {
    "ServiceName": "ILCDIA API",
    "PipelineVersion": "1.0.0",
    "ModelVersion": "clf-v1.0.0"
  },
  "Processing": {
    "MaxAttempts": 3,
    "RetryDelaySeconds": 5,
    "MaxConcurrentWorkers": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AdminPermitLimit": 300,
    "UserPermitLimit": 120,
    "AnonymousPermitLimit": 30,
    "QueueLimit": 50
