{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AdminPermitLimit": 200,
    "UserPermitLimit": 60,
    "AnonymousPermitLimit": 20,
    "QueueLimit": 20
  }
}
