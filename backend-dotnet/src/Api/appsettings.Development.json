{
  "AiEngine": {
    "Provider": "Hybrid",
    "Hybrid": {
      "EnablePythonFallback": true,
      "FallbackMinConfidence": 0.8
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AdminPermitLimit": 100000,
    "UserPermitLimit": 100000,
    "AnonymousPermitLimit": 10000,
    "QueueLimit": 10000
  }
}
