# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Sistema I.L.C.D.IA — Configuración de Producción                  ║
# ║  Copiar a .env y completar todos los valores CHANGE_ME             ║
# ║  NUNCA commitear este archivo con secretos reales.                  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Entorno ──
APP_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# ── Base de datos PostgreSQL ──
DB_HOST=CHANGE_ME_DB_HOST
DB_PORT=5432
DB_NAME=ilcdia
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# NOTA: ConnectionStrings__Default se genera automáticamente por set-production-config.ps1.
# Si editas manualmente, reemplaza los valores directamente:
ConnectionStrings__Default=Host=CHANGE_ME_DB_HOST;Port=5432;Database=ilcdia;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD

# ── JWT (clave para firmar tokens — mínimo 32 caracteres aleatorios) ──
Jwt__SigningKey=CHANGE_ME_RANDOM_32_PLUS_CHARS

# ── Comunicación API ↔ AI Engine (clave compartida) ──
PythonAi__BaseUrl=http://CHANGE_ME_AI_HOST:8000
PythonAi__ApiKey=CHANGE_ME_SHARED_API_KEY
API_KEY=CHANGE_ME_SHARED_API_KEY

# ── URLs y CORS ──
FRONTEND_ORIGIN=http://CHANGE_ME_FRONTEND_HOST:4200
# NOTA: Cors__AllowedOrigins__0 debe coincidir exactamente con FRONTEND_ORIGIN.
Cors__AllowedOrigins__0=http://CHANGE_ME_FRONTEND_HOST:4200

# ── Storage y retención ──
Storage__RetentionDays=365
Storage__CleanupIntervalMinutes=43200
RefreshTokens__StoragePath=storage/refresh_tokens.json
RefreshTokens__CleanupIntervalMinutes=10080
