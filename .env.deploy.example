# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Sistema I.L.C.D.IA — Plantilla de variables de entorno para PRODUCCIÓN ║
# ║                                                                          ║
# ║  1. Copiar este archivo a .env  (NUNCA commitear .env con valores reales)║
# ║  2. Reemplazar TODOS los CHANGE_ME con valores reales                    ║
# ║  3. Generar claves con:                                                  ║
# ║       python -c "import secrets; print(secrets.token_hex(32))"          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# ── Imagen Docker (para docker-compose.production.yml) ───────────────────────
# Sin "ghcr.io/" — solo org/repo
GITHUB_REPOSITORY=CHANGE_ME_ORG/CHANGE_ME_REPO
IMAGE_TAG=latest

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_RANDOM_32_CHARS

# ── JWT — firma de tokens (mínimo 32 caracteres aleatorios) ──────────────────
Jwt__SigningKey=CHANGE_ME_RANDOM_32_PLUS_CHARS_JWT_SIGNING_KEY

# ── Usuarios del sistema (bcrypt hash, cost 12) ───────────────────────────────
# Generar con:  python3 -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt(12)).decode())"
# O con:  bash scripts/generate-secrets.sh  (lo hace automáticamente)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH_FOR_ADMIN
USER_USERNAME=analyst
USER_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH_FOR_ANALYST

# ── Clave compartida API ↔ AI Engine (mínimo 24 chars) ───────────────────────
API_KEY=CHANGE_ME_SHARED_API_KEY_RANDOM_32_CHARS

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://CHANGE_ME_FRONTEND_HOST
HTTP_PORT=80
# HTTPS_PORT=443
# TLS_CERT_PATH=/etc/letsencrypt/live/CHANGE_ME_DOMAIN/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/CHANGE_ME_DOMAIN/privkey.pem

# ── GitHub CI (variable en Settings → Environments → production) ─────────────
# PRODUCTION_URL=https://CHANGE_ME_DOMAIN   (mostrado en el badge del deploy job)

# ── Storage y retención ───────────────────────────────────────────────────────
Storage__RetentionDays=365
Storage__CleanupIntervalMinutes=43200

# ── AI Engine — Performance ───────────────────────────────────────────────────
# Recomendado: (núcleos_CPU * 2) + 1
AI_WORKERS=4
AI_TIMEOUT=300
AUDIT_BASE_PATH=/app/storage

# ── LLM Fallback (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
# Google__ClientId=CHANGE_ME_GOOGLE_CLIENT_ID

# ── Rate limiting (opcional, defaults seguros) ────────────────────────────────
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60
