APP_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Backend API
Jwt__SigningKey=CHANGE_ME_STRONG_32_PLUS
ConnectionStrings__Default=Host=CHANGE_ME_DB_HOST;Port=5432;Database=ilcdia;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD

# API -> AI shared key (must match in both services)
PythonAi__ApiKey=CHANGE_ME_SHARED_STRONG_KEY
API_KEY=CHANGE_ME_SHARED_STRONG_KEY

# Runtime URLs
PythonAi__BaseUrl=http://CHANGE_ME_AI_HOST:8000

# Storage and retention
Storage__RetentionDays=365
Storage__CleanupIntervalMinutes=43200
RefreshTokens__StoragePath=storage/refresh_tokens.json
RefreshTokens__CleanupIntervalMinutes=10080

# Optional CORS (JSON in appsettings + env override if needed)
# Cors__AllowedOrigins__0=http://CHANGE_ME_FRONTEND_ORIGIN
